# =======================================================
# ScamShield AI — Environment Configuration Example
# =======================================================

# Optional: Google Gemini API Key for deep LLM reasoning and translations.
# If left empty, ScamShield AI automatically uses its trained offline ML model
# and heuristic explainability engine with full Hindi & Marathi support!
GEMINI_API_KEY=

# Gemini Model Name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:8000/api
